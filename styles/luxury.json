{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Luxury",
	"settings": {
		"color": {
			"palette": [
				{
					"slug": "base",
					"color": "#fafaf9",
					"name": "Base"
				},
				{
					"slug": "contrast",
					"color": "#1c1917",
					"name": "Contrast"
				},
				{
					"slug": "primary",
					"color": "#78716c",
					"name": "Primary"
				},
				{
					"slug": "secondary",
					"color": "#a8a29e",
					"name": "Secondary"
				},
				{
					"slug": "accent",
					"color": "#d4af37",
					"name": "Accent"
				}
			],
			"gradients": [
				{
					"slug": "luxury-gradient",
					"gradient": "linear-gradient(135deg, #d4af37 0%, #aa8829 100%)",
					"name": "Luxury Gradient"
				}
			]
		},
		"typography": {
			"fontSizes": [
				{
					"slug": "small",
					"size": "0.875rem",
					"name": "Small"
				},
				{
					"slug": "medium",
					"size": "1.125rem",
					"name": "Medium"
				},
				{
					"slug": "large",
					"size": "1.875rem",
					"name": "Large"
				},
				{
					"slug": "x-large",
					"size": "3rem",
					"name": "Extra Large"
				},
				{
					"slug": "xx-large",
					"size": "4.5rem",
					"name": "XX Large"
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--primary)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.8",
			"letterSpacing": "0.01em"
		},
		"spacing": {
			"blockGap": "var(--wp--preset--spacing--70)",
			"padding": {
				"top": "0",
				"right": "var(--wp--preset--spacing--60)",
				"bottom": "0",
				"left": "var(--wp--preset--spacing--60)"
			}
		},
		"elements": {
			"heading": {
				"typography": {
					"fontWeight": "300",
					"lineHeight": "1.2",
					"letterSpacing": "0.02em"
				},
				"color": {
					"text": "var(--wp--preset--color--primary)"
				}
			},
			"h1": {
				"typography": {
					"fontWeight": "200"
				}
			},
			"button": {
				"border": {
					"radius": "0",
					"width": "1px",
					"style": "solid",
					"color": "var(--wp--preset--color--accent)"
				},
				"color": {
					"background": "transparent",
					"text": "var(--wp--preset--color--accent)"
				},
				"typography": {
					"fontWeight": "400",
					"letterSpacing": "0.1em",
					"textTransform": "uppercase",
					"fontSize": "0.875rem"
				},
				"spacing": {
					"padding": {
						"top": "1rem",
						"right": "2.5rem",
						"bottom": "1rem",
						"left": "2.5rem"
					}
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--accent)",
						"text": "var(--wp--preset--color--contrast)"
					}
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--accent)"
				},
				"typography": {
					"textDecoration": "none"
				},
				":hover": {
					"typography": {
						"textDecoration": "underline"
					}
				}
			}
		},
		"blocks": {
			"core/separator": {
				"border": {
					"width": "1px",
					"color": "var(--wp--preset--color--accent)"
				}
			},
			"core/quote": {
				"border": {
					"width": "0 0 0 1px",
					"color": "var(--wp--preset--color--accent)"
				},
				"typography": {
					"fontStyle": "normal",
					"fontWeight": "300"
				}
			}
		}
	}
}
