{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Tech",
	"settings": {
		"color": {
			"palette": [
				{
					"slug": "base",
					"color": "#0a0a0a",
					"name": "Base"
				},
				{
					"slug": "contrast",
					"color": "#f5f5f5",
					"name": "Contrast"
				},
				{
					"slug": "primary",
					"color": "#3b82f6",
					"name": "Primary"
				},
				{
					"slug": "secondary",
					"color": "#06b6d4",
					"name": "Secondary"
				},
				{
					"slug": "accent",
					"color": "#8b5cf6",
					"name": "Accent"
				}
			],
			"gradients": [
				{
					"slug": "tech-gradient",
					"gradient": "linear-gradient(135deg, #3b82f6 0%, #8b5cf6 100%)",
					"name": "Tech Gradient"
				},
				{
					"slug": "cyber-gradient",
					"gradient": "linear-gradient(135deg, #06b6d4 0%, #3b82f6 100%)",
					"name": "Cyber Gradient"
				}
			]
		},
		"typography": {
			"fontSizes": [
				{
					"slug": "small",
					"size": "0.875rem",
					"name": "Small"
				},
				{
					"slug": "medium",
					"size": "1rem",
					"name": "Medium"
				},
				{
					"slug": "large",
					"size": "1.5rem",
					"name": "Large"
				},
				{
					"slug": "x-large",
					"size": "2.5rem",
					"name": "Extra Large"
				},
				{
					"slug": "xx-large",
					"size": "4rem",
					"name": "XX Large"
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--primary)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.7"
		},
		"spacing": {
			"blockGap": "var(--wp--preset--spacing--50)"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontWeight": "700",
					"letterSpacing": "-0.02em"
				},
				"color": {
					"text": "var(--wp--preset--color--contrast)",
					"gradient": "var(--wp--preset--gradient--tech-gradient)"
				}
			},
			"button": {
				"border": {
					"radius": "0.375rem",
					"width": "1px",
					"style": "solid",
					"color": "var(--wp--preset--color--primary)"
				},
				"color": {
					"background": "transparent",
					"text": "var(--wp--preset--color--primary)"
				},
				"typography": {
					"fontWeight": "600",
					"letterSpacing": "0.025em"
				},
				"spacing": {
					"padding": {
						"top": "0.875rem",
						"right": "1.75rem",
						"bottom": "0.875rem",
						"left": "1.75rem"
					}
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--primary)",
						"text": "var(--wp--preset--color--base)"
					},
					"border": {
						"color": "var(--wp--preset--color--primary)"
					}
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--primary)"
				},
				"typography": {
					"textDecoration": "none"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--secondary)"
					}
				}
			}
		},
		"blocks": {
			"core/code": {
				"color": {
					"background": "#1a1a1a",
					"text": "var(--wp--preset--color--secondary)"
				},
				"border": {
					"radius": "0.5rem",
					"width": "1px",
					"style": "solid",
					"color": "#2a2a2a"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--monospace)"
				}
			},
			"core/preformatted": {
				"color": {
					"background": "#1a1a1a",
					"text": "var(--wp--preset--color--secondary)"
				},
				"border": {
					"radius": "0.5rem"
				}
			},
			"core/separator": {
				"border": {
					"width": "2px",
					"style": "solid"
				},
				"color": {
					"gradient": "var(--wp--preset--gradient--tech-gradient)"
				}
			},
			"core/quote": {
				"border": {
					"width": "0 0 0 4px",
					"color": "var(--wp--preset--color--primary)"
				},
				"color": {
					"text": "var(--wp--preset--color--contrast)"
				}
			}
		}
	}
}
