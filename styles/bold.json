{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Bold",
	"settings": {
		"color": {
			"palette": [
				{
					"slug": "base",
					"color": "#ffffff",
					"name": "Base"
				},
				{
					"slug": "contrast",
					"color": "#000000",
					"name": "Contrast"
				},
				{
					"slug": "primary",
					"color": "#dc2626",
					"name": "Primary"
				},
				{
					"slug": "secondary",
					"color": "#ea580c",
					"name": "Secondary"
				},
				{
					"slug": "accent",
					"color": "#f59e0b",
					"name": "Accent"
				}
			]
		},
		"typography": {
			"fontSizes": [
				{
					"slug": "small",
					"size": "0.875rem",
					"name": "Small"
				},
				{
					"slug": "medium",
					"size": "1.125rem",
					"name": "Medium"
				},
				{
					"slug": "large",
					"size": "1.75rem",
					"name": "Large"
				},
				{
					"slug": "x-large",
					"size": "3rem",
					"name": "Extra Large"
				},
				{
					"slug": "xx-large",
					"size": "5rem",
					"name": "XX Large"
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--primary)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"fontWeight": "600",
			"lineHeight": "1.5"
		},
		"spacing": {
			"blockGap": "var(--wp--preset--spacing--60)"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontWeight": "900",
					"letterSpacing": "-0.02em",
					"textTransform": "uppercase"
				}
			},
			"button": {
				"border": {
					"radius": "0",
					"width": "3px",
					"style": "solid",
					"color": "var(--wp--preset--color--contrast)"
				},
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--base)"
				},
				"typography": {
					"fontWeight": "800",
					"textTransform": "uppercase",
					"letterSpacing": "0.05em"
				},
				"spacing": {
					"padding": {
						"top": "1rem",
						"right": "2rem",
						"bottom": "1rem",
						"left": "2rem"
					}
				}
			}
		},
		"blocks": {
			"core/separator": {
				"border": {
					"width": "4px"
				}
			}
		}
	}
}
