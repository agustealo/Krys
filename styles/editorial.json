{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Editorial",
	"settings": {
		"color": {
			"palette": [
				{
					"slug": "base",
					"color": "#fffef7",
					"name": "Base"
				},
				{
					"slug": "contrast",
					"color": "#0f0f0f",
					"name": "Contrast"
				},
				{
					"slug": "primary",
					"color": "#be123c",
					"name": "Primary"
				},
				{
					"slug": "secondary",
					"color": "#475569",
					"name": "Secondary"
				},
				{
					"slug": "accent",
					"color": "#dc2626",
					"name": "Accent"
				}
			]
		},
		"typography": {
			"fontSizes": [
				{
					"slug": "small",
					"size": "0.9375rem",
					"name": "Small"
				},
				{
					"slug": "medium",
					"size": "1.125rem",
					"name": "Medium"
				},
				{
					"slug": "large",
					"size": "1.875rem",
					"name": "Large"
				},
				{
					"slug": "x-large",
					"size": "2.75rem",
					"name": "Extra Large"
				},
				{
					"slug": "xx-large",
					"size": "4.5rem",
					"name": "XX Large"
				}
			]
		},
		"layout": {
			"contentSize": "680px",
			"wideSize": "1100px"
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--primary)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.75"
		},
		"spacing": {
			"blockGap": "var(--wp--preset--spacing--60)"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontWeight": "700",
					"lineHeight": "1.1",
					"letterSpacing": "-0.01em"
				}
			},
			"h1": {
				"typography": {
					"fontWeight": "900",
					"lineHeight": "1"
				}
			},
			"h2": {
				"typography": {
					"fontWeight": "800"
				}
			},
			"button": {
				"border": {
					"radius": "0.125rem"
				},
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--base)"
				},
				"typography": {
					"fontWeight": "600",
					"fontSize": "1rem"
				},
				"spacing": {
					"padding": {
						"top": "0.875rem",
						"right": "2rem",
						"bottom": "0.875rem",
						"left": "2rem"
					}
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--primary)"
				},
				"typography": {
					"textDecoration": "underline",
					"textDecorationThickness": "2px",
					"textUnderlineOffset": "0.2em"
				}
			}
		},
		"blocks": {
			"core/post-title": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xx-large)",
					"fontWeight": "900",
					"lineHeight": "1",
					"letterSpacing": "-0.02em"
				}
			},
			"core/post-date": {
				"color": {
					"text": "var(--wp--preset--color--secondary)"
				},
				"typography": {
					"fontSize": "0.875rem",
					"letterSpacing": "0.05em",
					"textTransform": "uppercase"
				}
			},
			"core/quote": {
				"border": {
					"width": "0",
					"style": "none"
				},
				"spacing": {
					"padding": {
						"top": "var(--wp--preset--spacing--50)",
						"bottom": "var(--wp--preset--spacing--50)"
					}
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)",
					"fontStyle": "normal",
					"fontWeight": "600",
					"lineHeight": "1.3"
				}
			},
			"core/pullquote": {
				"border": {
					"width": "4px 0",
					"color": "var(--wp--preset--color--primary)"
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)",
					"fontWeight": "600"
				}
			},
			"core/separator": {
				"border": {
					"width": "2px",
					"color": "var(--wp--preset--color--primary)"
				}
			}
		}
	}
}
