# Git attributes for Marcia Theme

# Auto detect text files and perform LF normalization
* text=auto

# Source code
*.php text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.js text eol=lf
*.json text eol=lf
*.html text eol=lf
*.xml text eol=lf
*.txt text eol=lf
*.md text eol=lf

# Configuration files
.editorconfig text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf

# Package files
package.json text eol=lf
composer.json text eol=lf

# Images
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.avif binary
*.svg text

# Fonts
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary

# Archives
*.zip binary
*.tar binary
*.gz binary
*.7z binary

# Exclude files from export
.gitattributes export-ignore
.gitignore export-ignore
.editorconfig export-ignore
.github export-ignore
.vscode export-ignore
node_modules export-ignore
package.json export-ignore
package-lock.json export-ignore
composer.json export-ignore
composer.lock export-ignore
*.md export-ignore
