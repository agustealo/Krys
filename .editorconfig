# EditorConfig for Marcia Theme
# https://editorconfig.org

# Top-most EditorConfig file
root = true

# Default settings for all files
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 4

# Markdown files
[*.md]
trim_trailing_whitespace = false

# JSON files
[*.json]
indent_style = tab
indent_size = 2

# YAML files
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# Package.json
[package.json]
indent_style = tab
indent_size = 2

# CSS, SCSS files
[*.{css,scss}]
indent_style = tab
indent_size = 2

# JavaScript files
[*.js]
indent_style = tab
indent_size = 2

# PHP files
[*.php]
indent_style = tab
indent_size = 4
