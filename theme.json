{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Marcia",
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "720px",
			"wideSize": "1280px"
		},
		"color": {
			"palette": [
				{
					"slug": "base",
					"color": "#ffffff",
					"name": "Base"
				},
				{
					"slug": "contrast",
					"color": "#000000",
					"name": "Contrast"
				},
				{
					"slug": "primary",
					"color": "#007cba",
					"name": "Primary"
				},
				{
					"slug": "secondary",
					"color": "#00a0d2",
					"name": "Secondary"
				},
				{
					"slug": "accent",
					"color": "#ff6900",
					"name": "Accent"
				},
				{
					"slug": "gray-50",
					"color": "#f9fafb",
					"name": "Gray 50"
				},
				{
					"slug": "gray-100",
					"color": "#f3f4f6",
					"name": "Gray 100"
				},
				{
					"slug": "gray-200",
					"color": "#e5e7eb",
					"name": "Gray 200"
				},
				{
					"slug": "gray-300",
					"color": "#d1d5db",
					"name": "Gray 300"
				},
				{
					"slug": "gray-400",
					"color": "#9ca3af",
					"name": "Gray 400"
				},
				{
					"slug": "gray-500",
					"color": "#6b7280",
					"name": "Gray 500"
				},
				{
					"slug": "gray-600",
					"color": "#4b5563",
					"name": "Gray 600"
				},
				{
					"slug": "gray-700",
					"color": "#374151",
					"name": "Gray 700"
				},
				{
					"slug": "gray-800",
					"color": "#1f2937",
					"name": "Gray 800"
				},
				{
					"slug": "gray-900",
					"color": "#111827",
					"name": "Gray 900"
				},
				{
					"slug": "success",
					"color": "#10b981",
					"name": "Success"
				},
				{
					"slug": "warning",
					"color": "#f59e0b",
					"name": "Warning"
				},
				{
					"slug": "error",
					"color": "#ef4444",
					"name": "Error"
				},
				{
					"slug": "info",
					"color": "#3b82f6",
					"name": "Info"
				}
			],
			"gradients": [
				{
					"slug": "primary-gradient",
					"gradient": "linear-gradient(135deg, var(--wp--preset--color--primary) 0%, var(--wp--preset--color--secondary) 100%)",
					"name": "Primary Gradient"
				},
				{
					"slug": "accent-gradient",
					"gradient": "linear-gradient(135deg, var(--wp--preset--color--accent) 0%, var(--wp--preset--color--primary) 100%)",
					"name": "Accent Gradient"
				},
				{
					"slug": "dark-gradient",
					"gradient": "linear-gradient(135deg, var(--wp--preset--color--gray-900) 0%, var(--wp--preset--color--gray-700) 100%)",
					"name": "Dark Gradient"
				}
			],
			"duotone": [
				{
					"slug": "primary-duotone",
					"colors": ["#000000", "#007cba"],
					"name": "Primary Duotone"
				},
				{
					"slug": "grayscale",
					"colors": ["#000000", "#ffffff"],
					"name": "Grayscale"
				}
			],
			"custom": true,
			"customDuotone": true,
			"customGradient": true,
			"defaultGradients": false,
			"defaultPalette": false,
			"link": true
		},
		"typography": {
			"fontFamilies": [
				{
					"fontFamily": "\"Radnika Variable\", system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
					"slug": "primary",
					"name": "Primary (Radnika)",
					"fontFace": [
						{
							"fontFamily": "Radnika Variable",
							"fontWeight": "300 900",
							"fontStyle": "normal",
							"fontStretch": "normal",
							"fontDisplay": "swap",
							"src": ["file:./assets/fonts/radnika-variable.woff2"]
						}
					]
				},
				{
					"fontFamily": "ui-monospace, \"SF Mono\", Monaco, \"Cascadia Code\", \"Roboto Mono\", Menlo, Consolas, \"Courier New\", monospace",
					"slug": "monospace",
					"name": "Monospace"
				},
				{
					"fontFamily": "system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif",
					"slug": "system",
					"name": "System"
				}
			],
			"fontSizes": [
				{
					"slug": "small",
					"size": "0.875rem",
					"name": "Small",
					"fluid": false
				},
				{
					"slug": "medium",
					"size": "1rem",
					"name": "Medium",
					"fluid": false
				},
				{
					"slug": "large",
					"size": "1.5rem",
					"name": "Large",
					"fluid": {
						"min": "1.25rem",
						"max": "1.5rem"
					}
				},
				{
					"slug": "x-large",
					"size": "2.5rem",
					"name": "Extra Large",
					"fluid": {
						"min": "2rem",
						"max": "2.5rem"
					}
				},
				{
					"slug": "xx-large",
					"size": "4rem",
					"name": "XX Large",
					"fluid": {
						"min": "2.5rem",
						"max": "4rem"
					}
				}
			],
			"fontStyle": true,
			"fontWeight": true,
			"letterSpacing": true,
			"lineHeight": true,
			"textDecoration": true,
			"textTransform": true,
			"dropCap": true,
			"writingMode": false
		},
		"spacing": {
			"spacingScale": {
				"steps": 0
			},
			"spacingSizes": [
				{
					"slug": "30",
					"size": "0.5rem",
					"name": "1"
				},
				{
					"slug": "40",
					"size": "1rem",
					"name": "2"
				},
				{
					"slug": "50",
					"size": "1.5rem",
					"name": "3"
				},
				{
					"slug": "60",
					"size": "2rem",
					"name": "4"
				},
				{
					"slug": "70",
					"size": "3rem",
					"name": "5"
				},
				{
					"slug": "80",
					"size": "4rem",
					"name": "6"
				}
			],
			"units": ["px", "em", "rem", "vh", "vw", "%"],
			"padding": true,
			"margin": true,
			"blockGap": true
		},
		"border": {
			"radius": true,
			"color": true,
			"style": true,
			"width": true
		},
		"shadow": {
			"presets": [
				{
					"slug": "natural",
					"shadow": "0 1px 3px rgba(0, 0, 0, 0.12), 0 1px 2px rgba(0, 0, 0, 0.24)",
					"name": "Natural"
				},
				{
					"slug": "lifted",
					"shadow": "0 14px 28px rgba(0, 0, 0, 0.12), 0 10px 10px rgba(0, 0, 0, 0.08)",
					"name": "Lifted"
				},
				{
					"slug": "deep",
					"shadow": "0 19px 38px rgba(0, 0, 0, 0.15), 0 15px 12px rgba(0, 0, 0, 0.10)",
					"name": "Deep"
				}
			],
			"defaultPresets": false
		},
		"dimensions": {
			"minHeight": true
		},
		"position": {
			"sticky": true
		},
		"custom": {
			"contentSize": "720px",
			"wideSize": "1280px",
			"lineHeight": {
				"tight": "1.2",
				"base": "1.6",
				"relaxed": "1.8"
			},
			"fontWeight": {
				"light": "300",
				"regular": "400",
				"medium": "500",
				"semibold": "600",
				"bold": "700",
				"extrabold": "800",
				"black": "900"
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--primary)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.6",
			"fontWeight": "400"
		},
		"spacing": {
			"blockGap": "var(--wp--preset--spacing--50)",
			"padding": {
				"top": "0",
				"right": "var(--wp--preset--spacing--50)",
				"bottom": "0",
				"left": "var(--wp--preset--spacing--50)"
			}
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--primary)"
				},
				"typography": {
					"textDecoration": "none"
				},
				":hover": {
					"typography": {
						"textDecoration": "underline"
					}
				},
				":focus": {
					"typography": {
						"textDecoration": "underline"
					},
					"outline": {
						"width": "2px",
						"style": "solid",
						"color": "var(--wp--preset--color--primary)",
						"offset": "2px"
					}
				}
			},
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--primary)",
					"fontWeight": "700",
					"lineHeight": "1.2"
				},
				"color": {
					"text": "var(--wp--preset--color--contrast)"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xx-large)",
					"lineHeight": "1.1"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)",
					"lineHeight": "1.2"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)",
					"lineHeight": "1.3"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "1.25rem",
					"lineHeight": "1.4"
				}
			},
			"h5": {
				"typography": {
					"fontSize": "1.125rem",
					"lineHeight": "1.5"
				}
			},
			"h6": {
				"typography": {
					"fontSize": "1rem",
					"lineHeight": "1.6"
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--base)"
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--medium)",
					"fontWeight": "600"
				},
				"border": {
					"radius": "0.25rem"
				},
				"spacing": {
					"padding": {
						"top": "0.75rem",
						"right": "1.5rem",
						"bottom": "0.75rem",
						"left": "1.5rem"
					}
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--secondary)"
					}
				},
				":focus": {
					"color": {
						"background": "var(--wp--preset--color--secondary)"
					},
					"outline": {
						"width": "2px",
						"style": "solid",
						"color": "var(--wp--preset--color--primary)",
						"offset": "2px"
					}
				}
			},
			"caption": {
				"color": {
					"text": "var(--wp--preset--color--gray-600)"
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)"
				}
			},
			"cite": {
				"typography": {
					"fontStyle": "italic"
				}
			}
		},
		"blocks": {
			"core/navigation": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--medium)",
					"fontWeight": "500"
				},
				"spacing": {
					"blockGap": "var(--wp--preset--spacing--50)"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var(--wp--preset--color--contrast)"
						},
						":hover": {
							"color": {
								"text": "var(--wp--preset--color--primary)"
							}
						}
					}
				}
			},
			"core/post-title": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xx-large)",
					"fontWeight": "700",
					"lineHeight": "1.1"
				},
				"spacing": {
					"margin": {
						"bottom": "var(--wp--preset--spacing--50)"
					}
				}
			},
			"core/post-date": {
				"color": {
					"text": "var(--wp--preset--color--gray-600)"
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)"
				}
			},
			"core/post-author": {
				"color": {
					"text": "var(--wp--preset--color--gray-600)"
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)"
				}
			},
			"core/site-title": {
				"typography": {
					"fontSize": "1.5rem",
					"fontWeight": "700"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var(--wp--preset--color--contrast)"
						},
						"typography": {
							"textDecoration": "none"
						},
						":hover": {
							"color": {
								"text": "var(--wp--preset--color--primary)"
							}
						}
					}
				}
			},
			"core/site-tagline": {
				"color": {
					"text": "var(--wp--preset--color--gray-600)"
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)"
				}
			},
			"core/button": {
				"border": {
					"radius": "0.25rem"
				},
				"typography": {
					"fontWeight": "600",
					"fontSize": "var(--wp--preset--font-size--medium)"
				},
				"spacing": {
					"padding": {
						"top": "0.75rem",
						"right": "1.5rem",
						"bottom": "0.75rem",
						"left": "1.5rem"
					}
				}
			},
			"core/quote": {
				"border": {
					"width": "0 0 0 4px",
					"style": "solid",
					"color": "var(--wp--preset--color--primary)"
				},
				"spacing": {
					"padding": {
						"left": "var(--wp--preset--spacing--50)"
					}
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)",
					"fontStyle": "italic"
				}
			},
			"core/pullquote": {
				"border": {
					"width": "4px 0",
					"style": "solid",
					"color": "var(--wp--preset--color--primary)"
				},
				"spacing": {
					"padding": {
						"top": "var(--wp--preset--spacing--50)",
						"bottom": "var(--wp--preset--spacing--50)"
					}
				}
			},
			"core/code": {
				"color": {
					"background": "var(--wp--preset--color--gray-100)",
					"text": "var(--wp--preset--color--gray-900)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--monospace)",
					"fontSize": "0.875rem"
				},
				"spacing": {
					"padding": "var(--wp--preset--spacing--40)"
				},
				"border": {
					"radius": "0.25rem"
				}
			},
			"core/preformatted": {
				"color": {
					"background": "var(--wp--preset--color--gray-100)",
					"text": "var(--wp--preset--color--gray-900)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--monospace)",
					"fontSize": "0.875rem"
				},
				"spacing": {
					"padding": "var(--wp--preset--spacing--40)"
				},
				"border": {
					"radius": "0.25rem"
				}
			},
			"core/separator": {
				"border": {
					"color": "var(--wp--preset--color--gray-300)",
					"width": "0 0 1px 0"
				},
				"color": {
					"text": "var(--wp--preset--color--gray-300)"
				}
			},
			"core/table": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)"
				}
			},
			"core/search": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--medium)"
				}
			}
		}
	},
	"customTemplates": [
		{
			"name": "blank",
			"title": "Blank Canvas",
			"postTypes": ["page", "post"]
		}
	],
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		}
	]
}
