{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "title": "Marcia",
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "720px",
      "wideSize": "1280px"
    },
    "color": {
      "custom": true,
      "customGradient": true,
      "defaultPalette": false,
      "defaultGradients": false,
      "link": true,
      "palette": [
        { "slug": "base", "color": "#ffffff", "name": "Base" },
        { "slug": "contrast", "color": "#111827", "name": "Contrast" },
        { "slug": "primary", "color": "#005f8f", "name": "Primary" },
        { "slug": "secondary", "color": "#006b87", "name": "Secondary" },
        { "slug": "accent", "color": "#b84a00", "name": "Accent" },
        { "slug": "gray-50", "color": "#f9fafb", "name": "Gray 50" },
        { "slug": "gray-100", "color": "#f3f4f6", "name": "Gray 100" },
        { "slug": "gray-200", "color": "#e5e7eb", "name": "Gray 200" },
        { "slug": "gray-300", "color": "#d1d5db", "name": "Gray 300" },
        { "slug": "gray-400", "color": "#9ca3af", "name": "Gray 400" },
        { "slug": "gray-500", "color": "#6b7280", "name": "Gray 500" },
        { "slug": "gray-600", "color": "#4b5563", "name": "Gray 600" },
        { "slug": "gray-700", "color": "#374151", "name": "Gray 700" },
        { "slug": "gray-800", "color": "#1f2937", "name": "Gray 800" },
        { "slug": "gray-900", "color": "#111827", "name": "Gray 900" },
        { "slug": "success", "color": "#137333", "name": "Success" },
        { "slug": "warning", "color": "#8a4b00", "name": "Warning" },
        { "slug": "error", "color": "#b42318", "name": "Error" },
        { "slug": "info", "color": "#1d4ed8", "name": "Info" }
      ],
      "gradients": [
        { "slug": "primary-gradient", "gradient": "linear-gradient(135deg, var(--wp--preset--color--primary) 0%, var(--wp--preset--color--secondary) 100%)", "name": "Primary Gradient" },
        { "slug": "accent-gradient", "gradient": "linear-gradient(135deg, var(--wp--preset--color--accent) 0%, var(--wp--preset--color--primary) 100%)", "name": "Accent Gradient" },
        { "slug": "dark-gradient", "gradient": "linear-gradient(135deg, var(--wp--preset--color--gray-900) 0%, var(--wp--preset--color--gray-700) 100%)", "name": "Dark Gradient" }
      ]
    },
    "typography": {
      "fontFamilies": [
        { "fontFamily": "system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif", "slug": "primary", "name": "System Sans" },
        { "fontFamily": "ui-monospace, \"SFMono-Regular\", Menlo, Monaco, Consolas, monospace", "slug": "monospace", "name": "Monospace" }
      ],
      "fontSizes": [
        { "slug": "small", "size": "0.875rem", "name": "Small" },
        { "slug": "medium", "size": "1rem", "name": "Medium" },
        { "slug": "large", "size": "1.5rem", "name": "Large", "fluid": { "min": "1.25rem", "max": "1.5rem" } },
        { "slug": "x-large", "size": "2.5rem", "name": "Extra Large", "fluid": { "min": "2rem", "max": "2.5rem" } },
        { "slug": "xx-large", "size": "4rem", "name": "XX Large", "fluid": { "min": "2.5rem", "max": "4rem" } },
        { "slug": "xxx-large", "size": "5rem", "name": "XXX Large", "fluid": { "min": "3rem", "max": "5rem" } }
      ],
      "fontStyle": true,
      "fontWeight": true,
      "letterSpacing": true,
      "lineHeight": true,
      "textDecoration": true,
      "textTransform": true
    },
    "spacing": {
      "spacingScale": { "steps": 0 },
      "spacingSizes": [
        { "slug": "30", "size": "0.5rem", "name": "1" },
        { "slug": "40", "size": "1rem", "name": "2" },
        { "slug": "50", "size": "1.5rem", "name": "3" },
        { "slug": "60", "size": "2rem", "name": "4" },
        { "slug": "70", "size": "3rem", "name": "5" },
        { "slug": "80", "size": "4rem", "name": "6" }
      ],
      "units": [ "px", "em", "rem", "vh", "vw", "%" ],
      "padding": true,
      "margin": true,
      "blockGap": true
    },
    "border": {
      "radius": true,
      "color": true,
      "style": true,
      "width": true
    },
    "shadow": {
      "defaultPresets": false,
      "presets": [
        { "slug": "natural", "shadow": "0 1px 3px rgba(0,0,0,.12), 0 1px 2px rgba(0,0,0,.18)", "name": "Natural" },
        { "slug": "lifted", "shadow": "0 14px 28px rgba(0,0,0,.12), 0 10px 10px rgba(0,0,0,.08)", "name": "Lifted" },
        { "slug": "deep", "shadow": "0 19px 38px rgba(0,0,0,.15), 0 15px 12px rgba(0,0,0,.10)", "name": "Deep" },
        { "slug": "large", "shadow": "0 24px 48px rgba(0,0,0,.16)", "name": "Large" }
      ]
    },
    "dimensions": { "minHeight": true },
    "position": { "sticky": true }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--base)",
      "text": "var(--wp--preset--color--contrast)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--primary)",
      "fontSize": "var(--wp--preset--font-size--medium)",
      "lineHeight": "1.6"
    },
    "spacing": {
      "blockGap": "var(--wp--preset--spacing--50)",
      "padding": {
        "left": "var(--wp--preset--spacing--50)",
        "right": "var(--wp--preset--spacing--50)"
      }
    },
    "elements": {
      "link": {
        "color": { "text": "var(--wp--preset--color--primary)" },
        "typography": { "textDecoration": "underline" }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--primary)",
          "text": "var(--wp--preset--color--base)"
        },
        "border": { "radius": "0.25rem" },
        "typography": { "fontWeight": "600" }
      },
      "heading": {
        "typography": { "lineHeight": "1.2", "fontWeight": "700" }
      }
    }
  },
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ]
}
